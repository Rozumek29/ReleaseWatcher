{
  "name": "releasewatcher",
  "version": "1.6.0",
  "private": true,
  "description": "Watches GitHub repositories for new releases and notifies Discord (and other channels).",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "start": "bun scripts/ensure-web.ts && bun src/main.ts",
    "serve": "bun src/main.ts",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch src/main.ts",
    "dev:web": "bun run --cwd web start",
    "build": "bun scripts/ensure-web.ts --force",
    "test": "bun run test:api && bun run test:web",
    "test:api": "bun test",
    "test:web": "bun run --cwd web test --watch=false",
    "typecheck": "tsc --noEmit",
    "compile": "bun scripts/compile.ts",
    "package": "bun scripts/package.ts",
    "deploy": "bun scripts/deploy-lxc.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "reflect-metadata": "^0.2.2"
  }
}
