# Copy to .env and fill in. Never commit .env.

# Discord channel → Edit channel → Integrations → Webhooks → New webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Optional: "@here", "@everyone" or "<@&ROLE_ID>"
DISCORD_MENTION=

# Optional but recommended: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# How often to check all repositories
POLL_INTERVAL_MINUTES=15

# --- Proxmox node (LXC container checks and updates) ---
# All of these can also be set in the UI (Settings → Proxmox node).
# Host name or IP of the Proxmox node; the app connects over SSH and runs `pct` there.
PROXMOX_HOST=
PROXMOX_SSH_PORT=22
# root, or a user allowed to run `pct` through passwordless sudo
PROXMOX_SSH_USER=root
# Path to the private key (key authentication only; keys with a passphrase are not supported)
PROXMOX_SSH_KEY_FILE=
# Host keys are trusted on first connection and pinned here (default: next to the database)
SSH_KNOWN_HOSTS_FILE=
# When containers are checked (cron: minute hour day-of-month month day-of-week, server time zone / TZ)
CONTAINER_CHECK_CRON=0 */6 * * *
# How many containers are checked at the same time (1-10)
CONTAINER_CHECK_CONCURRENCY=3
# Storage for backups (vzdump) made before updates, e.g. pbs or local
PROXMOX_BACKUP_STORAGE=
# Back up before updates by default (true/false); can be changed per container and per update
BACKUP_BEFORE_UPDATE=false

# --- Login ---
# The UI has its own login (one account: password and/or passkeys). On the first start the app logs a one-time
# setup code (also written to `setup-code` next to the database) – open the UI and create the account with it.
# Public address behind a reverse proxy, e.g. https://watcher.example.com – needed for passkeys (HTTPS + host name)
PUBLIC_URL=
# true only behind a reverse proxy that sets X-Forwarded-For (client IP for the login lockout and session list)
TRUST_PROXY=false
# Upgrading from Basic auth: when set and no account exists yet, the account is created with these credentials.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
