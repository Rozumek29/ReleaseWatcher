# Copy to .env and fill in. Never commit .env.

# Discord channel → Edit channel → Integrations → Webhooks → New webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Its HTTP method: POST (default), PUT or PATCH. Extra headers (e.g. Authorization) are set in the UI.
WEBHOOK_METHOD=
# Optional: "@here", "@everyone" or "<@&ROLE_ID>"
DISCORD_MENTION=

# E-mail notifications (all can also be set in Settings → Notifications). Security: starttls (port 587), tls (465)
# or none. Gmail/Outlook need an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# "alerts@example.com" or "ReleaseWatcher <alerts@example.com>"
EMAIL_FROM=
# Comma-separated recipients
EMAIL_TO=

# More channels (all can also be set in Settings → Notifications; secrets saved there are encrypted)
# ntfy: server (empty = https://ntfy.sh), topic and, for protected topics, an access token (tk_…) or user:password
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Gotify: server URL and the token of an application (Gotify → Apps → Create application)
GOTIFY_URL=
GOTIFY_TOKEN=
# Telegram: bot token from @BotFather and the chat id (-100… for groups/channels, or @channelname)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Pushover: user key (dashboard) and application API token
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
# Generic webhook: every notification is POSTed as JSON to this URL (n8n, Node-RED, Home Assistant …)
WEBHOOK_URL=

# true = everything one check run finds is sent as one summary message instead of one message each
NOTIFICATION_DIGEST=false

# Key that encrypts secrets in the database (tokens, webhook URL, SSH key, header values): 32 bytes, base64 or hex,
# e.g. `openssl rand -base64 32`. Empty = a key is generated into `encryption.key` next to the database.
# Losing the key means re-entering those secrets; keep it out of database backups for real protection.
ENCRYPTION_KEY=

# Optional but recommended: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# When to check all repositories for new releases (cron: minute hour day-of-month month day-of-week, server time zone / TZ)
RELEASE_CHECK_CRON=*/15 * * * *
# When to read the vulnerabilities (security advisories) of all repositories
ADVISORY_CHECK_CRON=0 */6 * * *
# When Docker endpoints are listed and the registries are asked for new images (Docker containers on machines reached
# over SSH are listed by their own checks; their images are checked on this schedule too)
DOCKER_CHECK_CRON=0 */6 * * *

# --- Proxmox node (LXC container checks and updates) ---
# All of these can also be set in the UI (Settings → Proxmox node).
# Proxmox node, read once on the first start: it becomes a host in Settings → Connections (edit it there afterwards).
# Host name or IP of the node; the app connects over SSH and runs `pct` there.
PROXMOX_HOST=
PROXMOX_SSH_PORT=22
# root, or a user allowed to run `pct` through passwordless sudo
PROXMOX_SSH_USER=root
# Path to the private key (key authentication only; keys with a passphrase are not supported)
PROXMOX_SSH_KEY_FILE=
# Host keys are trusted on first connection and pinned here (default: next to the database)
SSH_KNOWN_HOSTS_FILE=
# When containers are checked (cron: minute hour day-of-month month day-of-week, server time zone / TZ)
CONTAINER_CHECK_CRON=0 */6 * * *
# How many containers are checked at the same time (1-10)
CONTAINER_CHECK_CONCURRENCY=3
# Storage for backups (vzdump) made before updates, e.g. pbs or local – read once: given to the Proxmox nodes
# without their own storage (set per node in Settings → Connections afterwards)
PROXMOX_BACKUP_STORAGE=
# Back up before updates by default (true/false); can be changed per container and per update
BACKUP_BEFORE_UPDATE=false

# --- Login ---
# The UI has its own login (one account: password and/or passkeys). On the first start the app logs a one-time
# setup code (also written to `setup-code` next to the database) – open the UI and create the account with it.
# Public address behind a reverse proxy, e.g. https://watcher.example.com – needed for passkeys (HTTPS + host name)
PUBLIC_URL=
# true only behind a reverse proxy that sets X-Forwarded-For (client IP for the login lockout and session list)
TRUST_PROXY=false
# Upgrading from Basic auth: when set and no account exists yet, the account is created with these credentials.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Sign-in with an OpenID Connect provider (Pocket ID, Authentik, Keycloak, Authelia…) – defaults of Account → Single
# sign-on; link the account there afterwards. Redirect URI to register at the provider: <PUBLIC_URL>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
# empty = public client (PKCE only)
OIDC_CLIENT_SECRET=
# name on the sign-in button, e.g. Pocket ID
OIDC_NAME=

# --- Logging ---
# Minimum level: debug, info, warn, error or silent (logs are JSON lines on stdout/stderr)
LOG_LEVEL=info
# Also write the log to this file; empty = console only.
# Docker: /data/releasewatcher.log, native install (systemd): /var/log/releasewatcher/releasewatcher.log
LOG_FILE=
# Rotate the file when it reaches this size in MB (0 = never rotate)
LOG_FILE_MAX_SIZE_MB=10
# Rotated files to keep (releasewatcher.log.1 … .N); 0 = start the file over instead
LOG_FILE_MAX_FILES=5
