node_modules/
web/.angular/
web/dist/

# Angular build output is served by the server
/public/

# Release packages (npm run package)
/release/

# SQLite database
*.db
*.db-shm
*.db-wal

# Local secrets
.env
# Pinned SSH host keys of the Proxmox node (created next to the database)
known_hosts

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Compiled server executable (bun run compile)
/dist/
/.compile/

# Bun cache created by some local setups
.bun-cache/
# One-time setup code written next to a local database
setup-code
